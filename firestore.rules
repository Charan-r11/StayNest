rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isResident() {
      return isSignedIn() && getUserData().role == 'RESIDENT';
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'PROPERTY_OWNER';
    }

    function isMaintenance() {
      return isSignedIn() && getUserData().role == 'MAINTENANCE_STAFF' && getUserData().isApproved == true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isOwner());
    }

    // Properties Collection
    match /properties/{propertyId} {
      allow read: if true; // Publicly browsable PGs
      allow write: if isOwner();
    }

    // Rooms Collection
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Tickets Collection (Resident-submitted maintenance tickets)
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        isMaintenance() ||
        isOwner()
      );
      allow create: if isResident() && request.resource.data.residentId == request.auth.uid;
      allow update: if (isMaintenance() || isOwner()) || (isResident() && resource.data.residentId == request.auth.uid);
    }

    // Visits & Reservations
    match /visits/{visitId} {
      allow read: if isSignedIn() && (resource.data.residentId == request.auth.uid || isOwner());
      allow create: if isResident();
      allow update, delete: if isOwner() || resource.data.residentId == request.auth.uid;
    }

    match /reservations/{reservationId} {
      allow read: if isSignedIn() && (resource.data.residentId == request.auth.uid || isOwner());
      allow create: if isResident();
      allow update: if isOwner();
    }

    // Saved Properties
    match /saved_properties/{savedId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.residentId;
      allow create: if isSignedIn() && request.resource.data.residentId == request.auth.uid;
    }

    // Maintenance Staff Members Collection
    match /maintenance_members/{staffId} {
      allow read: if isSignedIn() && (isOwner() || request.auth.uid == staffId);
      allow write: if isOwner();
    }

    // Operations (Preventive schedules, Inspections, Housekeeping, Inventory, Alerts)
    match /preventive_schedules/{id} { allow read, write: if isMaintenance() || isOwner(); }
    match /inspections/{id} { allow read, write: if isMaintenance() || isOwner(); }
    match /housekeeping_tasks/{id} { allow read, write: if isMaintenance() || isOwner(); }
    match /inventory_items/{id} { allow read, write: if isMaintenance() || isOwner(); }
    match /alerts/{id} { allow read, write: if isMaintenance() || isOwner(); }
    match /messages/{id} { allow read, write: if isSignedIn(); }
    match /reviews/{id} { allow read: if true; allow create: if isResident(); }
    match /waitlists/{id} { allow read, write: if isSignedIn(); }
  }
}
